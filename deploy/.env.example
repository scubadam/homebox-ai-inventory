# Required by Homebox v0.26+ (generate with: openssl rand -base64 48)
HBOX_AUTH_API_KEY_PEPPER=change-me-to-at-least-32-random-bytes

# Homebox Authentication (API Key OR Username/Password)
HOMEBOX_API_KEY=
HOMEBOX_USERNAME=
HOMEBOX_PASSWORD=

# AI Provider: gemini (default), ollama, or openai
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-or-openai-api-key
AI_MODEL=gemini-2.5-flash

# Optional: custom base URL (e.g. http://localhost:11434 for local Ollama)
AI_BASE_URL=

# Optional: HTTP Basic Authentication to protect the PWA and API
# AUTH_USERNAME=admin
# AUTH_PASSWORD=secretpassword
